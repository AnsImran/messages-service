# ==============================================================================
# microservice_sms — Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust as needed.
#
#   cp .env.example .env
#
# This service holds NO secrets of its own. All BEEtexting credentials are
# fetched at call time from the sibling beetexting_token_service. Variable
# names are case-insensitive (e.g. token_service_url == TOKEN_SERVICE_URL).
# ==============================================================================

# ── Service identity ─────────────────────────────────────────────────────────
APP_NAME=microservice_sms
APP_VERSION=0.1.0

# ── FastAPI server settings ──────────────────────────────────────────────────
# Bind to localhost only by default; flip to 0.0.0.0 inside containers.
APP_HOST=127.0.0.1
APP_PORT=8200

# ── Logging ──────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
ACCESS_LOG_LEVEL=INFO

# ── Sibling token service ────────────────────────────────────────────────────
# Full URL of the beetexting_token_service /token endpoint. Used to fetch a
# fresh Bearer token + API key for every outbound BEEtexting request.
TOKEN_SERVICE_URL=http://localhost:8100/api/v1/token
TOKEN_SERVICE_TIMEOUT_SECONDS=10

# ── BEEtexting send-SMS endpoint ─────────────────────────────────────────────
BEETEXTING_SEND_URL=https://connect.beetexting.com/prod/message/sendsms
BEETEXTING_REQUEST_TIMEOUT_SECONDS=15
