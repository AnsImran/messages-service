# ==============================================================================
# microservice_sms — Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust as needed.
#
#   cp .env.example .env
#
# This service holds NO secrets of its own. All BEEtexting credentials are
# fetched at call time from the sibling beetexting_token_service. Variable
# names are case-insensitive (e.g. token_service_url == TOKEN_SERVICE_URL).
# ==============================================================================

# ── Service identity ─────────────────────────────────────────────────────────
APP_NAME=microservice_sms
APP_VERSION=0.1.0

# ── FastAPI server settings ──────────────────────────────────────────────────
# Bind to localhost only by default; flip to 0.0.0.0 inside containers.
APP_HOST=127.0.0.1
APP_PORT=8200

# ── Logging ──────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
ACCESS_LOG_LEVEL=INFO

# ── Sibling token service ────────────────────────────────────────────────────
# Full URL of the beetexting_token_service /token endpoint. Used to fetch a
# fresh Bearer token + API key for every outbound BEEtexting request.
TOKEN_SERVICE_URL=http://localhost:8100/api/v1/token
TOKEN_SERVICE_TIMEOUT_SECONDS=10

# ── BEEtexting send-SMS endpoint ─────────────────────────────────────────────
BEETEXTING_SEND_URL=https://connect.beetexting.com/prod/message/sendsms
BEETEXTING_REQUEST_TIMEOUT_SECONDS=15

# ── SMS batch queue (POST /api/v1/sms/batch) ─────────────────────────────────
# Only affects the queued multi-recipient endpoint. /sms/send is unaffected.
#
# SQLite file backing the durable queue. In Docker this defaults to
# /app/data/sms_queue.db on a named volume. For local dev, point it at a
# writable local path:
SMS_QUEUE_DB_PATH=./data/sms_queue.db
# Global gap between sends, across ALL concurrent batches (one worker).
SMS_INTER_MESSAGE_GAP_SECONDS=1.5
# Total attempts per recipient (initial try + retries) before giving up.
SMS_MAX_ATTEMPTS=5
# Exponential retry backoff: delay = base * factor**prior_attempts, capped.
SMS_BACKOFF_BASE_SECONDS=2.0
SMS_BACKOFF_FACTOR=2.0
SMS_BACKOFF_CAP_SECONDS=60.0
# Optional random jitter added to each backoff delay (0 disables).
SMS_BACKOFF_JITTER_SECONDS=0.0
# How long the worker sleeps when nothing is due before polling again.
SMS_WORKER_IDLE_POLL_INTERVAL_SECONDS=1.0
# Hard cap on recipients in a single /sms/batch request (after de-dupe).
SMS_MAX_RECIPIENTS_PER_BATCH=500
